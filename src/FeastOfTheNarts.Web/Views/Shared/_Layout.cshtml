<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Feast of the Narts</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <style>
            body {
                background-color: #1a1a1a;
                color: #f0f0f0;
                font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
                display: flex;
                flex-direction: column;
                min-height: 100vh;
            }

            main {
                flex: 1;
            }

            .card-auth {
                background-color: #2c2c2c;
                border: 1px solid #444;
                color: #fff;
            }

            input.form-control {
                background-color: #333;
                border: 1px solid #555;
                color: #fff;
            }

                input.form-control:focus {
                    background-color: #444;
                    color: #fff;
                    border-color: #ffc107;
                    box-shadow: 0 0 0 0.25rem rgba(255, 193, 7, 0.25);
                }

            .avatar-btn {
                width: 45px;
                height: 45px;
                border-radius: 50%;
                display: flex;
                align-items: center;
                justify-content: center;
                font-weight: bold;
                font-size: 1.2rem;
            }
    </style>
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-dark bg-dark border-bottom border-secondary mb-3 py-3">
            <div class="container-fluid px-4">
                <a class="navbar-brand text-warning fw-bold fs-4 tracking-wider" href="/">⚔️ FEAST OF THE NARTS</a>

                <div class="d-flex align-items-center">
                    @if (User.Identity != null && User.Identity.IsAuthenticated)
                    {
                        <button class="btn btn-warning avatar-btn text-dark shadow-sm" data-bs-toggle="modal" data-bs-target="#profileModal" title="Профиль">
                            @User.Identity.Name.Substring(0, 1).ToUpper()
                        </button>
                    }
                    else
                    {
                        <button type="button" class="btn btn-outline-warning" id="headerLoginBtn" data-bs-toggle="modal" data-bs-target="#authModal">Log In</button>
                    }
                </div>
            </div>
        </nav>
    </header>

    <main role="main" class="container d-flex align-items-center justify-content-center">
        @RenderBody()
    </main>

    <footer class="border-top border-secondary text-muted bg-dark py-4 mt-auto">
        <div class="container">
            <div class="row align-items-center">
                <div class="col-md-4 text-center text-md-start mb-3 mb-md-0">
                    <span class="text-warning fw-bold">FEAST OF THE NARTS</span> &copy; 2026
                </div>
                <div class="col-md-4 text-center mb-3 mb-md-0">
                    <a href="#" class="text-muted text-decoration-none me-3">Правила игры</a>
                    <a href="#" class="text-muted text-decoration-none">Поддержка</a>
                </div>
                <div class="col-md-4 text-center text-md-end">
                    <small>Связаться с нами: <a href="mailto:support@nartsgame.com" class="text-info">support@nartsgame.com</a></small>
                </div>
            </div>
        </div>
    </footer>

    
    <div class="modal fade" id="authModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered" style="max-width: 400px;">
            <div class="modal-content card-auth p-3 shadow-lg">
                <div class="modal-header border-0">
                    <h5 class="modal-title text-warning fw-bold fs-4">Вход в аккаунт</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <p class="text-light-50 small mb-4">Чтобы присоединиться к Пиру Нартов, необходимо войти в свою учётную запись.</p>
                    <form action="/Account/Login" method="POST">
                        <input type="hidden" name="returnUrl" class="dynamic-return-url" value="/" />
                        <div class="mb-3">
                            <label class="form-label text-white-50">Почта</label>
                            <input type="email" class="form-control" name="email" required>
                        </div>
                        <div class="mb-3">
                            <label class="form-label text-white-50">Пароль</label>
                            <input type="password" class="form-control" name="password" required>
                        </div>
                        <button type="submit" class="btn btn-warning w-100 fw-bold text-dark mt-2 py-2">Войти в игру</button>
                    </form>
                </div>
                <div class="modal-footer border-0 d-flex flex-column align-items-stretch mt-2">
                    <div class="text-center text-white-50 small mb-2">Нет аккаунта?</div>
                    <button class="btn btn-primary w-100 fw-bold py-2" data-bs-target="#registerModal" data-bs-toggle="modal">Зарегистрироваться</button>
                </div>
            </div>
        </div>
    </div>

    <div class="modal fade" id="registerModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered" style="max-width: 400px;">
            <div class="modal-content card-auth p-3 shadow-lg">
                <div class="modal-header border-0">
                    <h5 class="modal-title text-info fw-bold fs-4">Новый Герой</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <form action="/Account/Register" method="POST">
                        <input type="hidden" name="returnUrl" class="dynamic-return-url" value="/" />
                        <div class="mb-3">
                            <label class="form-label text-white-50">Логин</label>
                            <input type="text" class="form-control" name="username" required>
                        </div>
                        <div class="mb-3">
                            <label class="form-label text-white-50">Почта</label>
                            <input type="email" class="form-control" name="email" required>
                        </div>
                        <div class="mb-3">
                            <label class="form-label text-white-50">Пароль</label>
                            <input type="password" class="form-control" name="password" required>
                        </div>
                        <button type="submit" class="btn btn-primary w-100 fw-bold mt-2 py-2">Создать аккаунт</button>
                    </form>
                </div>
                <div class="modal-footer border-0 d-flex flex-column align-items-stretch mt-2">
                    <div class="text-center text-white-50 small mb-2">Уже с нами?</div>
                    <button class="btn btn-outline-warning w-100 fw-bold" data-bs-target="#authModal" data-bs-toggle="modal">Вернуться ко входу</button>
                </div>
            </div>
        </div>
    </div>

    

    @if (User.Identity != null && User.Identity.IsAuthenticated)
    {
        <div class="modal fade" id="profileModal" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered modal-sm">
                <div class="modal-content card-auth p-3 shadow-lg">
                    <div class="modal-header border-0">
                        <h5 class="modal-title text-warning fw-bold">Данные игрока</h5>
                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body text-center">
                        <div class="avatar-btn bg-warning text-dark mx-auto mb-3" style="width: 80px; height: 80px; font-size: 2.5rem;">
                            @User.Identity.Name.Substring(0, 1).ToUpper()
                        </div>
                        <h4 class="text-white mb-4">@User.Identity.Name</h4>

                        <a href="/Account/Logout" class="btn btn-danger w-100 fw-bold">Выйти из аккаунта</a>
                    </div>
                </div>
            </div>
        </div>
    }

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

    <script>
        function setReturnUrl(url) {
        document.querySelectorAll('.dynamic-return-url').forEach(input => input.value = url);
        }

        //если нажал на "Log In" вверху то останется на текущей странице
        document.getElementById('headerLoginBtn')?.addEventListener('click', () => setReturnUrl('/'));
    </script>
</body>
</html>
