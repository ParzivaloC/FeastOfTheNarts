<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Feast of the Narts</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />

    <style>
            body {
                background-color: #1a1a1a;
                color: #f0f0f0;
                font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            }

            .card-auth {
                background-color: #2c2c2c;
                border: 1px solid #444;
                color: #fff;
            }

            input.form-control {
                background-color: #333;
                border: 1px solid #555;
                color: #fff;
            }

                input.form-control:focus {
                    background-color: #444;
                    color: #fff;
                    border-color: #ffc107;
                    box-shadow: 0 0 0 0.25rem rgba(255, 193, 7, 0.25);
                }
    </style>
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-dark bg-dark border-bottom box-shadow mb-3">
            <div class="container-fluid justify-content-center">
                <a class="navbar-brand text-warning" href="/">⚔️ ПИР НА РТОВ ⚔️</a>
            </div>
        </nav>
    </header>

    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted text-center fixed-bottom bg-dark py-2">
        <div class="container">
            &copy; 2026 - Feast of the Narts Team
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>