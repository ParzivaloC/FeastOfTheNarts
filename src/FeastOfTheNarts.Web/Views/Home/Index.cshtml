@{
    Layout = "_Layout";
    ViewData["Title"] = "Главное Меню";
    bool isAuthenticated = User.Identity?.IsAuthenticated ?? false;
}

<div class="text-center w-100">
    @if (TempData["AuthError"] != null)
    {
        <div class="alert alert-danger mx-auto" style="max-width: 400px;">@TempData["AuthError"]</div>
    }
    <h1 class="display-2 text-warning mb-5 fw-bold ethnic-font" style="letter-spacing: 5px;">НАРТТЫ ФЫНГ</h1>

    <div class="d-grid gap-4 col-10 col-md-4 mx-auto">
        <button id="playBtn" class="btn btn-warning btn-lg py-3 fw-bold text-dark shadow fs-4 ethnic-font">▶️ ХЪАЗЫН</button>
        <a href="/Glossary" class="btn btn-outline-warning btn-lg py-2 fs-5 ethnic-font">📖 Таурӕгътӕ</a>
        <button class="btn btn-outline-secondary btn-lg py-2 fs-5 ethnic-font">⚙️ Æвзæрстытæ</button>
    </div>
</div>

<script>
    document.getElementById("playBtn").addEventListener("click", function () {
        const isUserLoggedIn = @isAuthenticated.ToString().ToLower();

        if (isUserLoggedIn) {
            //если залогинен - летим в игру
            window.location.href = "/Game";
        } else {
            //если нет - меняем скрытый инпут, чтобы после модалки перекинуло в игру
            if (typeof setReturnUrl === "function") {
                setReturnUrl('/Game');
            }
            //открывает модалку из Layout
            const myModal = new bootstrap.Modal(document.getElementById('authModal'));
            myModal.show();
        }
    });
</script>
