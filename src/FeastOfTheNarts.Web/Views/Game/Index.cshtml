@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <title>Пир Нартов - Бой</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/game.css" asp-append-version="true" />
</head>
<body>

    <div class="battle-layout">

        <div class="sidebar-left">
            <div class="player-profile opponent">
                <div class="avatar">👤</div>
                <h5 class="text-warning mt-2 mb-1">Противник</h5>
                <div class="fs-6">❤️ <span id="opponent-lives">0</span></div>
                <div class="fs-6">🃏 В руке: <span id="opponent-handCount">0</span></div>
                <div class="fs-4 fw-bold mt-2"><span id="opponent-totalPower">0</span></div>
            </div>

            <div class="player-profile player">
                <div class="fs-4 text-success fw-bold mb-2"><span id="you-totalPower">0</span></div>
                <div class="fs-6">❤️ <span id="you-lives">0</span></div>
                <div class="fs-6">🃏 В руке: <span id="you-handCount">0</span></div> 
                <h5 class="text-warning mb-2 mt-1">Gin Sakai</h5> <div class="avatar">🥷</div>
                <button class="btn btn-light text-dark fw-bold w-100 mt-2">Пас</button>
            </div>
        </div>

        <div class="board-center">
            <div class="player-board-half">
                <div class="board-row opponent-row siege" data-row="Siege">
                    <div class="row-score" id="opponent-siege-power">0</div>
                    <div class="row-cards-container" id="opponent-siege-cards"></div>
                </div>
                <div class="board-row opponent-row ranged" data-row="Ranged">
                    <div class="row-score" id="opponent-ranged-power">0</div>
                    <div class="row-cards-container" id="opponent-ranged-cards"></div>
                </div>
                <div class="board-row opponent-row melee" data-row="Melee">
                    <div class="row-score" id="opponent-melee-power">0</div>
                    <div class="row-cards-container" id="opponent-melee-cards"></div>
                </div>
            </div>

            <hr class="border-warning opacity-25 my-0">

            <div class="player-board-half">
                <div class="board-row player-row melee" data-row="Melee">
                    <div class="row-score" id="you-melee-power">0</div>
                    <div class="row-cards-container" id="you-melee-cards"></div>
                </div>
                <div class="board-row player-row ranged" data-row="Ranged">
                    <div class="row-score" id="you-ranged-power">0</div>
                    <div class="row-cards-container" id="you-ranged-cards"></div>
                </div>
                <div class="board-row player-row siege" data-row="Siege">
                    <div class="row-score" id="you-siege-power">0</div>
                    <div class="row-cards-container" id="you-siege-cards"></div>
                </div>
            </div>

            <div class="hand-row" id="you-hand"></div>
        </div>

        <div class="sidebar-right">
            <button class="btn btn-outline-danger w-100 fw-bold shadow-sm" data-bs-toggle="modal" data-bs-target="#leaveGameModal">
                🚪 Выход
            </button>

            <div class="deck-area mt-auto">
                <div class="fs-3 mb-1">🎴</div>
                <div class="fs-6 text-warning">Колода</div>
                <div class="fw-bold"><span id="you-deckCount">0</span> шт.</div>
            </div>
        </div>

    </div>

    <div class="modal fade" id="leaveGameModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-sm">
            <div class="modal-content bg-dark text-light border-danger shadow-lg">
                <div class="modal-header border-danger">
                    <h5 class="modal-title text-danger fw-bold">Покинуть игру?</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body text-center">
                    <p class="mb-0">Точно выйти в меню?</p>
                </div>
                <div class="modal-footer border-danger d-flex justify-content-between">
                    <button type="button" class="btn btn-secondary w-100 mb-2" data-bs-dismiss="modal">Остаться</button>
                    <button type="button" class="btn btn-danger fw-bold w-100 m-0" id="confirmLeaveBtn">Да, выйти</button>
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

    <script>
        document.getElementById('confirmLeaveBtn').addEventListener('click', function() {
        window.location.href = '/';
        });
    </script>

    <script src="~/lib/microsoft-signalr/signalr.min.js"></script>
    <script src="~/js/game.js"></script>

</body>
</html>